# --- Required by the SEC for EDGAR access: a descriptive "Name email" string ---
SEC_USER_AGENT=Your Name you@example.com

# --- Optional. Without it FRED's public CSV export is used (no key needed). ---
FRED_API_KEY=

# --- Optional LLM enrichment of theses (everything works deterministically without it) ---
# LLM_PROVIDER=auto|openai|anthropic|none
LLM_PROVIDER=auto
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Storage: SQLite by default. For Supabase/Postgres: postgresql+psycopg://user:pass@host:5432/db ---
# DATABASE_URL=

# --- Dev knobs ---
# UNIVERSE_LIMIT=20
# PRICE_RANGE=5y

# --- Optional: YouTube Data API v3 key (Google Cloud console, free quota) for video-velocity attention ---
YOUTUBE_API_KEY=
