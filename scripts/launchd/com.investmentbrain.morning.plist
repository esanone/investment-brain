<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.investmentbrain.morning</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/eduardosanchez/Projects/investment-brain/scripts/morning.sh</string>
  </array>
  <!-- Weekdays at 06:15 local time: attention -> brief -> long-term thesis -> recalibration (~30 min), ready before the 09:30 ET open -->
